{
  "info": {
    "name": "Auth API (Sofiya)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "refresh_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Register",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Sofia\",\n  \"email\": \"sofia@mail.com\",\n  \"password\": \"123456\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/register/",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "register", ""]
        },
        "description": "Creates a new user. Returns JWT tokens and user data."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "if (json.token) {",
              "    pm.collectionVariables.set('access_token', json.token);",
              "    pm.collectionVariables.set('refresh_token', json.refresh);",
              "    console.log('Tokens saved automatically');",
              "}"
            ]
          }
        }
      ],
      "response": [
        {
          "name": "201 Created — successful registration",
          "status": "Created",
          "code": 201,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"token\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\",\n  \"refresh\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\",\n  \"user\": {\n    \"id\": 1,\n    \"name\": \"Sofia\",\n    \"email\": \"sofia@mail.com\"\n  }\n}"
        },
        {
          "name": "400 Bad Request — email already taken",
          "status": "Bad Request",
          "code": 400,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"message\": {\n    \"email\": [\"A user with this email already exists.\"]\n  }\n}"
        }
      ]
    },
    {
      "name": "2. Login",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"sofia@mail.com\",\n  \"password\": \"123456\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/login/",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "login", ""]
        },
        "description": "Authenticates a user by email and password. Returns a JWT token."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "if (json.token) {",
              "    pm.collectionVariables.set('access_token', json.token);",
              "    pm.collectionVariables.set('refresh_token', json.refresh);",
              "    console.log('Tokens saved automatically');",
              "}"
            ]
          }
        }
      ],
      "response": [
        {
          "name": "200 OK — successful login",
          "status": "OK",
          "code": 200,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"token\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\",\n  \"refresh\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\",\n  \"user\": {\n    \"id\": 1,\n    \"name\": \"Sofia\",\n    \"email\": \"sofia@mail.com\"\n  }\n}"
        },
        {
          "name": "400 Bad Request — wrong password",
          "status": "Bad Request",
          "code": 400,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"message\": {\n    \"non_field_errors\": [\"Invalid email or password.\"]\n  }\n}"
        }
      ]
    },
    {
      "name": "3. Logout",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{access_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/logout/",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "logout", ""]
        },
        "description": "Invalidates the refresh token. Requires Authorization: Bearer <access_token>."
      },
      "response": [
        {
          "name": "200 OK — successful logout",
          "status": "OK",
          "code": 200,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"message\": \"Logged out successfully.\"\n}"
        },
        {
          "name": "401 Unauthorized — no token provided",
          "status": "Unauthorized",
          "code": 401,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"detail\": \"Authentication credentials were not provided.\"\n}"
        }
      ]
    },
    {
      "name": "4. Current User (GET /me/)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{access_token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/api/auth/me/",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "me", ""]
        },
        "description": "Returns the data of the currently authenticated user. Requires a valid token."
      },
      "response": [
        {
          "name": "200 OK",
          "status": "OK",
          "code": 200,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"user\": {\n    \"id\": 1,\n    \"name\": \"Sofia\",\n    \"email\": \"sofia@mail.com\"\n  }\n}"
        }
      ]
    }
  ]
}