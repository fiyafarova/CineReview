{
  "info": {
    "name": "Auth API (Sofiya)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "refresh_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Регистрация",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Sofia\",\n  \"email\": \"sofia@mail.com\",\n  \"password\": \"123456\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/register/",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "register", ""]
        },
        "description": "Создаёт нового пользователя. Возвращает JWT токен и данные пользователя."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "if (json.token) {",
              "    pm.collectionVariables.set('access_token', json.token);",
              "    pm.collectionVariables.set('refresh_token', json.refresh);",
              "    console.log('Токены сохранены автоматически');",
              "}"
            ]
          }
        }
      ],
      "response": [
        {
          "name": "201 Created — успешная регистрация",
          "status": "Created",
          "code": 201,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"token\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\",\n  \"refresh\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\",\n  \"user\": {\n    \"id\": 1,\n    \"name\": \"Sofia\",\n    \"email\": \"sofia@mail.com\"\n  }\n}"
        },
        {
          "name": "400 Bad Request — email уже занят",
          "status": "Bad Request",
          "code": 400,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"message\": {\n    \"email\": [\"Пользователь с таким email уже существует.\"]\n  }\n}"
        }
      ]
    },
    {
      "name": "2. Логин",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"sofia@mail.com\",\n  \"password\": \"123456\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/login/",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "login", ""]
        },
        "description": "Авторизует пользователя по email и паролю. Возвращает JWT токен."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "if (json.token) {",
              "    pm.collectionVariables.set('access_token', json.token);",
              "    pm.collectionVariables.set('refresh_token', json.refresh);",
              "    console.log('Токены сохранены автоматически');",
              "}"
            ]
          }
        }
      ],
      "response": [
        {
          "name": "200 OK — успешный логин",
          "status": "OK",
          "code": 200,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"token\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\",\n  \"refresh\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\",\n  \"user\": {\n    \"id\": 1,\n    \"name\": \"Sofia\",\n    \"email\": \"sofia@mail.com\"\n  }\n}"
        },
        {
          "name": "400 Bad Request — неверный пароль",
          "status": "Bad Request",
          "code": 400,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"message\": {\n    \"non_field_errors\": [\"Неверный email или пароль.\"]\n  }\n}"
        }
      ]
    },
    {
      "name": "3. Логаут",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{access_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/logout/",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "logout", ""]
        },
        "description": "Инвалидирует refresh токен. Требует Authorization: Bearer <access_token>."
      },
      "response": [
        {
          "name": "200 OK — успешный выход",
          "status": "OK",
          "code": 200,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"message\": \"Выход выполнен успешно.\"\n}"
        },
        {
          "name": "401 Unauthorized — нет токена",
          "status": "Unauthorized",
          "code": 401,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"detail\": \"Authentication credentials were not provided.\"\n}"
        }
      ]
    },
    {
      "name": "4. Текущий пользователь (GET /me/)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{access_token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/api/auth/me/",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "me", ""]
        },
        "description": "Возвращает данные текущего авторизованного пользователя. Требует токен."
      },
      "response": [
        {
          "name": "200 OK",
          "status": "OK",
          "code": 200,
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"user\": {\n    \"id\": 1,\n    \"name\": \"Sofia\",\n    \"email\": \"sofia@mail.com\"\n  }\n}"
        }
      ]
    }
  ]
}